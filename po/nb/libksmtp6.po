#: job.cpp:60
#, kde-format
msgid "Service not available"
msgstr "Tjenesten er ikke tilgjengelig"

#: job.cpp:62
#, kde-format
msgid "Mailbox unavailable. The server said: %1"
msgstr "Postboksen er ikke tilgjengelig. Tjeneren sa: %1"

#: job.cpp:64
#, kde-format
msgid "Insufficient storage space on server. The server said: %1"
msgstr "Ikke nok ledig plass på tjeneren. Tjeneren sa: %1"

#: job.cpp:66
#, kde-format
msgid "Server error: %1"
msgstr "Tjenerfeil: %1"

#: job.cpp:75
#, kde-format
msgid "Connection to server lost."
msgstr "Tilkoblingen til tjeneren ble brutt."

#: loginjob.cpp:77
#, kde-format
msgid "Login"
msgstr "Innlogging"

#: loginjob.cpp:168
#, kde-format
msgid ""
"Could not authenticate to the SMTP server because no matching authentication "
"method has been found"
msgstr ""
"Klarte ikke autentisere med SMTP-tjeneren fordi ingen støttede "
"autentiseringsmetoder ble funnet."

#: loginjob.cpp:227
#, kde-format
msgid "Token expired"
msgstr ""

#: loginjob.cpp:271
#, kde-format
msgid "Login failed, cannot initialize the SASL library"
msgstr "Innlogging var mislykket. Klarte ikke starte SASL-biblioteket."

#: sendjob.cpp:58
#, kde-format
msgid "SendJob"
msgstr ""

#: sendjob.cpp:107
#, kde-format
msgid ""
"Could not send the message because either the sender or recipient field is "
"missing or invalid"
msgstr ""
"Klarte ikke sende meldingen, da enten avsender- eller mottakerfeltet mangler "
"eller er ugyldig."

#: sendjob.cpp:115
#, kde-format
msgid ""
"Could not send the message because it exceeds the maximum allowed size of %1 "
"bytes. (Message size: %2 bytes.)"
msgstr ""
"Klarte ikke sende meldingen, da den er større enn maksstørrelsen på %1 byte. "
"(Meldingsstørrelse: %2 byte.)"

#: sendjob.cpp:124
#, kde-format
msgid "The message needs and server does not support UTF-8 email addresses"
msgstr ""
